    {
      "name": "2. Authentication & JWT",
      "description": "Registration, sign in, JWT token generation, profile retrieval, OTP codes, and session termination.",
      "item": [
        {
          "name": "Sign In (Generates JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.environment.set('jwtToken', res.data.token);",
                  "    pm.collectionVariables.set('jwtToken', res.data.token);",
                  "    console.log('JWT Token stored successfully:', res.data.token);",
                  "}",
                  "if (res.data && res.data.user && res.data.user.id) {",
                  "    if (res.data.user.role === 'candidate') {",
                  "        pm.environment.set('candidateId', res.data.user.id);",
                  "        pm.collectionVariables.set('candidateId', res.data.user.id);",
                  "    } else if (res.data.user.role === 'company') {",
                  "        pm.environment.set('companyId', res.data.user.id);",
                  "        pm.collectionVariables.set('companyId', res.data.user.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@talentflow.io\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signin"]
            },
            "description": "Authenticates user credentials, sets session in Dragonfly DB, and returns a signed JWT token."
          }
        },
        {
          "name": "Sign Up - Quick Registration",
          "event": [
