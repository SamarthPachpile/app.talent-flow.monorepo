{
  "name": "@talent-flow/monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "lerna run dev --parallel",
    "dev:all": "lerna run dev --parallel",
    "dev:api": "npm run dev --workspace=@talent-flow/api",
    "dev:admin": "npm run dev --workspace=@talent-flow/admin-panel",
    "dev:candidate": "npm run dev --workspace=@talent-flow/candidate-portal",
    "dev:company": "npm run dev --workspace=@talent-flow/company-portal",
    "dev:graviton": "npm run dev --workspace=@talent-flow/graviton-it-solutions",
    "build": "lerna run build",
    "build:all": "lerna run build",
    "start": "npm run start --workspace=@talent-flow/api",
    "lint": "lerna run lint",
    "lint:fix": "lerna run lint-fix",
    "lint-fix": "lerna run lint-fix",
    "format": "prettier --write .",
    "clean": "lerna clean --yes",
    "dragonfly:start": "docker compose up -d dragonfly",
    "dragonfly:stop": "docker compose down",
    "dragonfly:logs": "docker compose logs -f dragonfly",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lerna": "^10.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.7.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0"
  },
  "lint-staged": {
    "packages/**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
