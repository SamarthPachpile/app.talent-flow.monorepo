# ==============================================================================
# TalentFlow CRM Monorepo Environment Configuration (Template)
# ==============================================================================
#
# Available environment files:
#  - .env.development  : Used automatically for local development
#  - .env.production   : Used automatically during production builds & deployment
#  - .env.local        : Overrides all environments locally (gitignored)
#
# ==============================================================================

# Core API Server & Services
PORT=5000
NODE_ENV=development # or 'production'
HOST=0.0.0.0

# API Endpoints:
# Development: http://localhost:5000
# Production:  https://app-talent-flow-monorepo-api.vercel.app
VITE_API_URL=http://localhost:5000

# Client App Ports
VITE_PORT_GRAVITON_IT_SOLUTIONS=3000
VITE_PORT_ADMIN_PANEL=3001
VITE_PORT_COMPANY_ONBOARDING=3002
VITE_PORT_CANDIDATE_PORTAL=3003

# Admin Static Credentials
VITE_ADMIN_USERNAME=Admin
VITE_ADMIN_PASSWORD=admin123

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/talentflow?retryWrites=true&w=majority
MONGODB_DATABASE=talentflow

# In-Memory Cache (Dragonfly Cloud / Local)
DRAGONFLY_URL=rediss://default:<password>@<host>.dragonflydb.cloud:6385
DRAGONFLY_HOST=127.0.0.1
DRAGONFLY_PORT=6379
DRAGONFLY_USERNAME=default
DRAGONFLY_PASSWORD=
DRAGONFLY_TLS=false
DRAGONFLY_CACHE_TTL=3600

# Authentication & Security
JWT_SECRET=talentflow_super_secret_jwt_key_2026_production
SESSION_SECRET=talentflow_session_secret_2026_secure
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth Callback & Client Domains
# Development: http://localhost:5000/api/auth/google/callback
# Production:  https://app-talent-flow-monorepo-api.vercel.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
CLIENT_DOMAIN_URL=http://localhost:3000
LANDING_DOMAIN_URL=http://localhost:3000
GRAVITON_DOMAIN_URL=http://localhost:3000
ADMIN_DOMAIN_URL=http://localhost:3001
CANDIDATE_DOMAIN_URL=http://localhost:3003
COMPANY_DOMAIN_URL=http://localhost:3002
