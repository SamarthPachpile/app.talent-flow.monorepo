{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@candidate-portal/*": ["./src/*"],
      "@candidate-portal": ["./src"],
      "@candidate/*": ["./src/*"],
      "@candidate": ["./src"],
      "@talent-flow/candidate-portal": ["./src/App.tsx"],
      "@talent-flow/candidate-portal/*": ["./src/*"],
      "@talent-flow/api": ["../api/src/index.ts"],
      "@talent-flow/api/*": ["../api/src/*"],
      "@talent-flow/schema-types": ["../schema-types/src/index.ts"],
      "@talent-flow/schema-types/*": ["../schema-types/src/*"],
      "@talent-flow/utilities": ["../utilities/src/index.ts"],
      "@talent-flow/utilities/*": ["../utilities/src/*"],
      "@talent-flow/admin-panel": ["../admin-panel/src/components/AdminPanelContainer.tsx"],
      "@talent-flow/company-portal": ["../company-portal/src/App.tsx"],
      "@talent-flow/company-onboarding": ["../company-portal/src/App.tsx"],
      "@talent-flow/graviton-it-solutions": ["../graviton-it-solutions/src/App.tsx"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
