{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@": ["./src"],
      "@candidate-portal/*": ["./src/*"],
      "@candidate-portal": ["./src"],
      "@candidate/*": ["./src/*"],
      "@candidate": ["./src"],
      "@talent-flow/candidate-portal/*": ["./src/*"],
      "@talent-flow/candidate-portal": ["./src/App.tsx", "./src"],

      "@talent-flow/api": ["../api/src/index.ts"],
      "@talent-flow/api/*": ["../api/src/*"],
      "@api": ["../api/src/index.ts"],
      "@api/*": ["../api/src/*"],

      "@talent-flow/admin-panel": ["../admin-panel/src/components/AdminPanelContainer.tsx"],
      "@talent-flow/admin-panel/*": ["../admin-panel/src/*"],
      "@admin-panel/*": ["../admin-panel/src/*"],
      "@admin-panel": ["../admin-panel/src"],
      "@admin/*": ["../admin-panel/src/*"],
      "@admin": ["../admin-panel/src"],

      "@talent-flow/company-onboarding": ["../company-onboarding/src/App.tsx"],
      "@talent-flow/company-onboarding/*": ["../company-onboarding/src/*"],
      "@company-onboarding/*": ["../company-onboarding/src/*"],
      "@company-onboarding": ["../company-onboarding/src"],
      "@onboarding/*": ["../company-onboarding/src/*"],
      "@onboarding": ["../company-onboarding/src"],

      "@talent-flow/croton-it-solutions": ["../croton-it-solutions/src/App.tsx"],
      "@talent-flow/croton-it-solutions/*": ["../croton-it-solutions/src/*"],
      "@croton-it-solutions/*": ["../croton-it-solutions/src/*"],
      "@croton-it-solutions": ["../croton-it-solutions/src"],
      "@croton/*": ["../croton-it-solutions/src/*"],
      "@croton": ["../croton-it-solutions/src"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "../../tailwind.config.ts"]
}
