{
  "include": ["src/**/*", "vite.config.ts", "eslint.config.js", "../../tailwind.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@": ["./src"],
      "@admin-panel/*": ["./src/*"],
      "@admin-panel": ["./src"],
      "@admin/*": ["./src/*"],
      "@admin": ["./src"],
      "@talent-flow/admin-panel/*": ["./src/*"],
      "@talent-flow/admin-panel": ["./src/components/AdminPanelContainer.tsx", "./src"],

      "@talent-flow/api": ["../api/src/index.ts"],
      "@talent-flow/api/*": ["../api/src/*"],
      "@api": ["../api/src/index.ts"],
      "@api/*": ["../api/src/*"],

      "@talent-flow/candidate-portal": ["../candidate-portal/src/App.tsx"],
      "@talent-flow/candidate-portal/*": ["../candidate-portal/src/*"],
      "@candidate-portal/*": ["../candidate-portal/src/*"],
      "@candidate-portal": ["../candidate-portal/src"],
      "@candidate/*": ["../candidate-portal/src/*"],
      "@candidate": ["../candidate-portal/src"],

      "@talent-flow/company-onboarding": ["../company-onboarding/src/App.tsx"],
      "@talent-flow/company-onboarding/*": ["../company-onboarding/src/*"],
      "@company-onboarding/*": ["../company-onboarding/src/*"],
      "@company-onboarding": ["../company-onboarding/src"],
      "@onboarding/*": ["../company-onboarding/src/*"],
      "@onboarding": ["../company-onboarding/src"],

      "@talent-flow/graviton-it-solutions": ["../graviton-it-solutions/src/App.tsx"],
      "@talent-flow/graviton-it-solutions/*": ["../graviton-it-solutions/src/*"],
      "@graviton-it-solutions/*": ["../graviton-it-solutions/src/*"],
      "@graviton-it-solutions": ["../graviton-it-solutions/src"],
      "@graviton/*": ["../graviton-it-solutions/src/*"],
      "@graviton": ["../graviton-it-solutions/src"]
    }
  }
}
