{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "dist",
    "baseUrl": "./",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@talent-flow/schema-types": ["../schema-types/src/index.ts"],
      "@talent-flow/schema-types/*": ["../schema-types/src/*"],
      "@talent-flow/utilities": ["../utilities/src/index.ts"],
      "@talent-flow/utilities/*": ["../utilities/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
